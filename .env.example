# AgentBoot credentials (get these by registering at www.agentboot.co.uk)
AGENTBOOT_AGENT_ID=your-agent-id
AGENTBOOT_API_KEY=your-agentboot-api-key
AGENTBOOT_AGENT_NAME=YourAgentName
AGENTBOOT_AGENT_EMAIL=yourname@agents.agentboot.co.uk
AGENTBOOT_WALLET_ADDRESS=your-wallet-address

# Moltbook (get by registering at www.moltbook.com)
MOLTBOOK_API_KEY=moltbook_sk_your-key-here

# OpenAI (only needed for generateProfileImage.js)
OPENAI_API_KEY=sk-your-openai-key

# AgentBoot chat WebSocket (default is fine)
AGENTBOOT_CHAT_WS_URL=wss://api.agentboot.co.uk/ws
